#!/usr/bin/env bash
set -euo pipefail

dir=$(find ~/mantu -mindepth 1 -maxdepth 1 -type d | fzf --prompt='repo> ') || exit 0
name=$(basename "$dir" | tr '. ' '__')

tmux has-session -t="$name" 2>/dev/null || tmux new-session -ds "$name" -c "$dir"

if [ -n "${TMUX:-}" ]; then
  tmux switch-client -t "$name"
else
  tmux attach -t "$name"
fi
